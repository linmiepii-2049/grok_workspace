{
  "name": "jt-projects",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "jt": "node tools/jt/jt.mjs",
    "db:migrate": "wrangler d1 migrations apply jteam --remote -c infra/wrangler.jsonc",
    "viewer:dev": "wrangler dev -c apps/viewer/wrangler.jsonc --port 8788",
