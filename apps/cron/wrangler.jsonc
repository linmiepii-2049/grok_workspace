// jteam-cron：準時觸發 GitHub Actions（GitHub 自己的 cron 常延遲數小時）
// 部署：npm run cron:deploy；需要 secret（wrangler secret put GITHUB_TOKEN -c apps/cron/wrangler.jsonc）：
//   fine-grained token，只給 linmiepii-2049/JT-Projects 的 Actions: Read and write
{
  "name": "jteam-cron",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "account_id": "090a04034814d8905c2a759afa46d73e",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // UTC；和 .github/workflows/portfolio.yml 的 cron 保持一致
  "triggers": { "crons": ["59 12 * * 1-5", "59 21 * * 1-5"] },
  "vars": { "REPO": "linmiepii-2049/JT-Projects" }
}
