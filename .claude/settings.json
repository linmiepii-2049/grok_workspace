{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { [ -x node_modules/.bin/wrangler ] || npm ci --no-audit --no-fund --loglevel=error; }",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/jt/jt.mjs\" check --hook"
          }
        ]
      }
    ]
  }
}
